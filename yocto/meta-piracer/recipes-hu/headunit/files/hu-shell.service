[Unit]
Description=PiRacer Head Unit Shell (Wayland Compositor)
After=network.target dbus.service
# Weston 의존성 없음: hu_shell 자신이 QtWayland Compositor로 동작

[Service]
Type=simple
User=root
# hu_shell은 Wayland Compositor: eglfs로 DRM/KMS에 직접 접근
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_KMS_CONFIG=/usr/bin/config/kms_headunit.json
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
# XDG_RUNTIME_DIR: 모듈 프로세스들이 wayland-hu 소켓을 찾는 경로
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=QT_FONT_DPI=96
Environment=VSOMEIP_CONFIGURATION=/usr/bin/config/vsomeip_headunit.json
Environment=HU_REAR_CAMERA_DEVICE=/dev/video0
ExecStartPre=/bin/sh -c 'mkdir -p /run/user/0 && chmod 700 /run/user/0'
ExecStartPre=-/bin/sh -c 'ip link set can0 type can bitrate 500000 2>/dev/null && ip link set can0 up 2>/dev/null'
ExecStart=/usr/bin/hu_shell
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
